# Postgres — local Docker container (see docker-compose.yml, Phase 3)
DATABASE_URL=postgres://kosh:kosh@localhost:5436/kosh

# API
API_PORT=3001
JWT_ACCESS_SECRET=change-me-generate-a-long-random-string
# Access token TTL in seconds (default: 900 = 15 min)
JWT_ACCESS_TTL=900
# Refresh token TTL in seconds (default: 2592000 = 30 days)
REFRESH_TOKEN_TTL=2592000
# Comma-separated origin allowlist for credentialed CORS
CORS_ORIGINS=http://localhost:3000
# Log level (default: debug in dev, info in prod, silent in test)
# LOG_LEVEL=debug

# Web (Next.js) — where the API lives
NEXT_PUBLIC_API_URL=http://localhost:3001
